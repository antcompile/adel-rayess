---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import VideoPlayer from "../../islands/VideoPlayer";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";

const lang = "ar";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("media.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/media" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("media.title")} subtitle={t("media.subtitle")} />
      </ScrollReveal>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {Array.from({ length: 3 }).map((_, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <VideoPlayer client:visible videoId="dQw4w9WgXcQ" title={`فيديو مميز ${i + 1}`} />
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
