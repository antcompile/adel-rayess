---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import VideoPlayer from "../../islands/VideoPlayer";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";

const lang = "ar";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("gallery.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/gallery" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("gallery.title")} subtitle={t("gallery.subtitle")} />
      </ScrollReveal>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {[
          { id: "u_eEpuY7r_g", title: "حل عرق النسا" },
          { id: "x0J6XiKTYIM", title: "ليست فقط لبناء العضلات" },
          { id: "rDTXi0EY5FU", title: "التخلص من انحناء الظهر" },
          { id: "aTVCo0Q_HmE", title: "الحل النهائي للصداع النصفي" },
          { id: "QV81cH92C60", title: "جراحة ديسك فاشلة" },
          { id: "h6TrZ92Aei0", title: "رجل لم يتوقف عن الاهتزاز لمدة 4 سنوات" },
        ].map((video, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <VideoPlayer client:visible videoId={video.id} title={video.title} />
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
