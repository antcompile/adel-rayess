---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import VideoPlayer from "../../islands/VideoPlayer";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";

const lang = "fr";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("media.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/media" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("media.title")} subtitle={t("media.subtitle")} />
      </ScrollReveal>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
        {[
          { id: "9rXfho-DEgA", title: "Interview: L'art osteopathique" },
          { id: "Sl5_us7VkCA", title: "Seminaire NeuroSpine Vienne 2026" },
          { id: "Km3Wtv8LkQs", title: "Le medicament n'est pas toujours en bouteille" },
        ].map((video, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <VideoPlayer client:visible videoId={video.id} title={video.title} />
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
