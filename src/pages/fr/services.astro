---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { services } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";
import { Activity } from "lucide-react";

const lang = "fr";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("services.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/services" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("services.title")} subtitle={t("services.subtitle")} />
      </ScrollReveal>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        {services.map((service, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <div class="p-10 bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 hover:shadow-lg transition-all duration-300 group">
              <div class="w-14 h-14 flex items-center justify-center text-[var(--color-accent)] mb-6 group-hover:scale-110 transition-transform duration-200">
                <Activity size={32} />
              </div>
              <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-4">{service.title[lang]}</h3>
              <p class="text-[var(--color-text-secondary)] leading-relaxed">{service.description[lang]}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-accent)]/5">
    <div class="container mx-auto text-center">
      <ScrollReveal client:visible>
        <h2 class="text-4xl font-serif font-bold text-[var(--color-text)] mb-6">{t("cta.title")}</h2>
        <a href={getLocalizedPath(lang, "/contact")} class="inline-block px-8 py-4 bg-[var(--color-cta)] text-white font-semibold rounded-lg hover:bg-[var(--color-cta-hover)] transition-colors duration-200 cursor-pointer">
          {t("cta.button")}
        </a>
      </ScrollReveal>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
