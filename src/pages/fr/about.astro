---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";
import { Award } from "lucide-react";

const lang = "fr";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("about.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/about" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("about.title")} subtitle={t("about.subtitle")} />
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mt-12">
        <ScrollReveal client:visible>
          <div class="aspect-[3/4] bg-[var(--color-surface-elevated)] border border-[var(--color-border)] flex items-center justify-center">
            <p class="text-[var(--color-text-secondary)] text-sm">Portrait du Dr. Adel Rayess</p>
          </div>
        </ScrollReveal>
        <ScrollReveal client:visible delay={0.2}>
          <div>
            <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-8">{t("about.bio")}</p>
            <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-6">{t("about.credentials")}</h3>
            <ul class="space-y-4">
              {[t("about.credential1"), t("about.credential2"), t("about.credential3"), t("about.credential4")].map((cred) => (
                <li class="flex items-start gap-3">
                  <Award className="w-5 h-5 text-[var(--color-accent)] mt-0.5 shrink-0" />
                  <span class="text-[var(--color-text-secondary)]">{cred}</span>
                </li>
              ))}
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container mx-auto text-center">
      <ScrollReveal client:visible>
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-[var(--color-text)] mb-6">{t("about.methodology")}</h2>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-3xl mx-auto">{t("about.methodologyDesc")}</p>
      </ScrollReveal>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
