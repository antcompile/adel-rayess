---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";
import { Award, Globe, BookOpen, Clock } from "lucide-react";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("about.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/about" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("about.title")} subtitle={t("about.subtitle")} />
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mt-12">
        <ScrollReveal client:visible>
          <div class="aspect-[3/4] bg-[var(--color-surface-elevated)] border border-[var(--color-border)] flex items-center justify-center">
            <p class="text-[var(--color-text-secondary)] text-sm">Dr. Adel Rayess Portrait</p>
          </div>
        </ScrollReveal>

        <ScrollReveal client:visible delay={0.2}>
          <div>
            <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-8">
              {t("about.bio")}
            </p>

            <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-6">
              {t("about.credentials")}
            </h3>
            <ul class="space-y-4">
              {[
                { icon: Award, text: t("about.credential1") },
                { icon: Globe, text: t("about.credential2") },
                { icon: BookOpen, text: t("about.credential3") },
                { icon: Clock, text: t("about.credential4") },
              ].map((cred) => (
                <li class="flex items-start gap-3">
                  <cred.icon className="w-5 h-5 text-[var(--color-accent)] mt-0.5 shrink-0" />
                  <span class="text-[var(--color-text-secondary)]">{cred.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-serif font-bold text-[var(--color-text)] mb-6 text-center">
            {t("about.methodology")}
          </h2>
          <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed text-center">
            {t("about.methodologyDesc")}
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
