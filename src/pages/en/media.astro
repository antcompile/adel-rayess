---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import VideoPlayer from "../../islands/VideoPlayer";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";

const lang = "en";
const t = useTranslations(lang);

const featuredVideos = [
  { id: "9rXfho-DEgA", title: "Interview: The Osteopathic Art - Finding the Primary Lesion" },
  { id: "Sl5_us7VkCA", title: "NeuroSpine Seminar Vienna 2026 Announcement" },
  { id: "vfR0TgKZwI8", title: "Balance Problem - Wrong Diagnosis for 3 Years" },
];

const pressItems = [
  { title: "Dr. Rayess featured in Top 10 Osteopaths in the Middle East", source: "Medical Today", year: "2024" },
  { title: "The Primary Lesion: A New Approach to Spinal Health", source: "Health & Wellness Magazine", year: "2023" },
  { title: "Social Media Doctor: How Dr. Rayess Built a 10M Following", source: "Digital Health Journal", year: "2024" },
  { title: "Revolutionary Non-Surgical Spine Treatment Gains Recognition", source: "Lebanon Medical Review", year: "2023" },
];
---

<BaseLayout title={`${t("media.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/media" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("media.title")} subtitle={t("media.subtitle")} />
      </ScrollReveal>

      <div class="mt-12">
        <ScrollReveal client:visible>
          <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-8">Featured Videos</h3>
        </ScrollReveal>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredVideos.map((video, i) => (
            <ScrollReveal client:visible delay={i * 0.1}>
              <VideoPlayer client:visible videoId={video.id} title={video.title} />
            </ScrollReveal>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-8">{t("media.press")}</h3>
      </ScrollReveal>

      <div class="space-y-4 max-w-3xl">
        {pressItems.map((item, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <div class="p-6 border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 transition-colors duration-200 cursor-pointer">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h4 class="font-medium text-[var(--color-text)]">{item.title}</h4>
                  <p class="text-sm text-[var(--color-text-secondary)] mt-1">{item.source}</p>
                </div>
                <span class="text-sm text-[var(--color-accent)] font-medium shrink-0">{item.year}</span>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-8">{t("media.events")}</h3>
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl">
        <ScrollReveal client:visible>
          <div class="p-8 bg-[var(--color-surface)] border border-[var(--color-border)]">
            <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">October 2025</span>
            <h4 class="text-xl font-serif font-bold text-[var(--color-text)] mt-3">IGMEDT 2025</h4>
            <p class="text-sm text-[var(--color-text-secondary)] mt-2">International conference on integrative medicine. Vienna, Austria.</p>
          </div>
        </ScrollReveal>
        <ScrollReveal client:visible delay={0.1}>
          <div class="p-8 bg-[var(--color-surface)] border border-[var(--color-border)]">
            <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">May 2026</span>
            <h4 class="text-xl font-serif font-bold text-[var(--color-text)] mt-3">NeuroSpine Seminar</h4>
            <p class="text-sm text-[var(--color-text-secondary)] mt-2">Advanced spinal neurology and treatment approaches. Vienna, Austria.</p>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
