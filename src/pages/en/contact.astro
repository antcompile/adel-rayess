---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import ContactForm from "../../islands/ContactForm";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";
import { MapPin, Phone, Mail, Clock } from "lucide-react";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout title={`${t("contact.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/contact" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("contact.title")} subtitle={t("contact.subtitle")} />
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mt-12">
        <div>
          <ContactForm
            client:visible
            labels={{
              name: t("contact.form.name"),
              email: t("contact.form.email"),
              phone: t("contact.form.phone"),
              message: t("contact.form.message"),
              submit: t("contact.form.submit"),
              success: t("contact.form.success"),
              error: t("contact.form.error"),
            }}
            formspreeUrl={siteConfig.formspree}
          />
        </div>

        <ScrollReveal client:visible delay={0.2}>
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <MapPin className="w-5 h-5 text-[var(--color-accent)] mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-[var(--color-text)] mb-1">{t("contact.info.address")}</h4>
                <p class="text-[var(--color-text-secondary)]">
                  {siteConfig.address.line1}<br />
                  {siteConfig.address.city}, {siteConfig.address.country}
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <Phone className="w-5 h-5 text-[var(--color-accent)] mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-[var(--color-text)] mb-1">{t("contact.info.phone")}</h4>
                <p class="text-[var(--color-text-secondary)]">
                  <a href={`tel:${siteConfig.phone.replace(/\s/g, "")}`} class="hover:text-[var(--color-accent)] transition-colors duration-200 cursor-pointer">{siteConfig.phone}</a><br />
                  <a href={`tel:${siteConfig.mobile.replace(/\s/g, "")}`} class="hover:text-[var(--color-accent)] transition-colors duration-200 cursor-pointer">{siteConfig.mobile}</a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <Mail className="w-5 h-5 text-[var(--color-accent)] mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-[var(--color-text)] mb-1">{t("contact.info.email")}</h4>
                <p class="text-[var(--color-text-secondary)]">
                  <a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--color-accent)] transition-colors duration-200 cursor-pointer">{siteConfig.email}</a>
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <Clock className="w-5 h-5 text-[var(--color-accent)] mt-1 shrink-0" />
              <div>
                <h4 class="font-semibold text-[var(--color-text)] mb-1">{t("contact.info.hours")}</h4>
                <p class="text-[var(--color-text-secondary)]">{siteConfig.hours}</p>
              </div>
            </div>

            <div class="mt-8 aspect-video bg-[var(--color-surface-elevated)] border border-[var(--color-border)] flex items-center justify-center">
              <p class="text-[var(--color-text-secondary)] text-sm">Google Maps Embed - Zalka, Lebanon</p>
            </div>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
