---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";
import { Calendar, Users, BookOpen, Globe } from "lucide-react";

const lang = "en";
const t = useTranslations(lang);

const programs = [
  {
    title: "The Primary Lesion - Intensive",
    duration: "3 Days",
    description: "Master the diagnostic methodology that identifies the primary biomechanical dysfunction. Hands-on clinical practice with live patients.",
    topics: ["Primary Lesion identification", "Biomechanical assessment", "Treatment protocol design", "Clinical case studies"],
  },
  {
    title: "Rayess-Schoening Technique",
    duration: "2 Days",
    description: "Advanced manual technique for spinal correction. Prerequisites: Basic osteopathic training.",
    topics: ["Cervical technique", "Thoracic adjustments", "Lumbar protocols", "Safety considerations"],
  },
  {
    title: "Perineural Infiltration",
    duration: "1 Day",
    description: "Specialized injection technique for nerve-related pain conditions. Guided practical sessions.",
    topics: ["Anatomy review", "Injection technique", "Patient selection", "Follow-up protocols"],
  },
];

const events = [
  { name: "IGMEDT 2025 - Vienna", date: "October 2025", type: "Speaker" },
  { name: "NeuroSpine Seminar - Vienna", date: "May 2026", type: "Lecturer" },
];
---

<BaseLayout title={`${t("training.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/training" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("training.title")} subtitle={t("training.subtitle")} />
        <p class="text-lg text-[var(--color-text-secondary)] text-center max-w-2xl mx-auto mt-4">
          {t("training.description")}
        </p>
      </ScrollReveal>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-16">
        {programs.map((program, i) => (
          <ScrollReveal client:visible delay={i * 0.15}>
            <div class="p-8 bg-[var(--color-surface)] border border-[var(--color-border)] h-full flex flex-col">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-accent)]">{program.duration}</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-[var(--color-text)] mb-4">{program.title}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">{program.description}</p>
              <ul class="space-y-2 mt-auto">
                {program.topics.map((topic) => (
                  <li class="flex items-center gap-2 text-sm text-[var(--color-text-secondary)]">
                    <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></div>
                    {topic}
                  </li>
                ))}
              </ul>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title="Upcoming Events" subtitle="International conferences and seminars" />
      </ScrollReveal>

      <div class="max-w-2xl mx-auto space-y-6 mt-8">
        {events.map((event, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <div class="flex items-center justify-between p-6 border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 transition-colors duration-200">
              <div>
                <h4 class="font-semibold text-[var(--color-text)]">{event.name}</h4>
                <p class="text-sm text-[var(--color-text-secondary)] mt-1">{event.type}</p>
              </div>
              <span class="text-sm font-medium text-[var(--color-accent)]">{event.date}</span>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-accent)]/5">
    <div class="container mx-auto text-center">
      <ScrollReveal client:visible>
        <h2 class="text-3xl font-serif font-bold text-[var(--color-text)] mb-4">Interested in Training?</h2>
        <p class="text-[var(--color-text-secondary)] mb-8">Contact us to register for upcoming programs or inquire about custom training sessions.</p>
        <a href={getLocalizedPath(lang, "/contact")} class="inline-block px-8 py-4 bg-[var(--color-cta)] text-white font-semibold rounded-lg hover:bg-[var(--color-cta-hover)] transition-colors duration-200 cursor-pointer">
          Register Interest
        </a>
      </ScrollReveal>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
