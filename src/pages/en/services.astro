---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import { useTranslations, getLocalizedPath } from "../../i18n/utils";
import { services } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";
import { Activity, Heart, Brain, User, Dumbbell, ArrowDownUp } from "lucide-react";

const lang = "en";
const t = useTranslations(lang);

const iconComponents: Record<string, any> = { Activity, Heart, Brain, User, Dumbbell, ArrowDownUp };

const equipment = [
  { name: "Lordex Spinal Decompression", desc: "Computer-guided decompression therapy for disc herniation and stenosis" },
  { name: "Theraflex", desc: "Advanced spinal mobilization and flexibility restoration system" },
  { name: "Huber Motion Lab", desc: "3D balance and posture training platform for rehabilitation" },
  { name: "Laser Therapy", desc: "Low-level laser for pain reduction and tissue healing" },
  { name: "Electrotherapy", desc: "Electrical stimulation for nerve and muscle recovery" },
];
---

<BaseLayout title={`${t("services.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/services" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("services.title")} subtitle={t("services.subtitle")} />
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        {services.map((service, i) => {
          const Icon = iconComponents[service.icon] || Activity;
          return (
            <ScrollReveal client:visible delay={i * 0.1}>
              <div class="p-10 bg-[var(--color-surface)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 hover:shadow-lg transition-all duration-300 group">
                <div class="w-14 h-14 flex items-center justify-center text-[var(--color-accent)] mb-6 group-hover:scale-110 transition-transform duration-200">
                  <Icon size={32} />
                </div>
                <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-4">
                  {service.title[lang]}
                </h3>
                <p class="text-[var(--color-text-secondary)] leading-relaxed">
                  {service.description[lang]}
                </p>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title="Advanced Equipment" subtitle="State-of-the-art technology for optimal treatment outcomes" />
      </ScrollReveal>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {equipment.map((item, i) => (
          <ScrollReveal client:visible delay={i * 0.1}>
            <div class="p-6 border border-[var(--color-border)] hover:border-[var(--color-accent)]/30 transition-colors duration-200">
              <h4 class="text-lg font-semibold text-[var(--color-text)] mb-2">{item.name}</h4>
              <p class="text-sm text-[var(--color-text-secondary)]">{item.desc}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-accent)]/5">
    <div class="container mx-auto text-center">
      <ScrollReveal client:visible>
        <h2 class="text-4xl font-serif font-bold text-[var(--color-text)] mb-6">{t("cta.title")}</h2>
        <a href={getLocalizedPath(lang, "/contact")} class="inline-block px-8 py-4 bg-[var(--color-cta)] text-white font-semibold rounded-lg hover:bg-[var(--color-cta-hover)] transition-colors duration-200 cursor-pointer">
          {t("cta.button")}
        </a>
      </ScrollReveal>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
