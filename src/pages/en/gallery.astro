---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ScrollReveal from "../../islands/ScrollReveal";
import VideoPlayer from "../../islands/VideoPlayer";
import { useTranslations } from "../../i18n/utils";
import { siteConfig } from "../../data/siteConfig";

const lang = "en";
const t = useTranslations(lang);

const videos = [
  { id: "u_eEpuY7r_g", title: "Sciatica Solution" },
  { id: "x0J6XiKTYIM", title: "Not Just For Building Muscles" },
  { id: "rDTXi0EY5FU", title: "Get Rid of Back Curvature" },
  { id: "rSCCNiizfxM", title: "The #1 Killer Disease of Our Era" },
  { id: "Km3Wtv8LkQs", title: "Medicine Isn't Always in Bottles" },
  { id: "aTVCo0Q_HmE", title: "Final Solution for Migraines" },
  { id: "QV81cH92C60", title: "Failed Disc Surgery - Non-Surgical Fix" },
  { id: "h6TrZ92Aei0", title: "Man Couldn't Stop Shaking for 4 Years" },
  { id: "2qABQW_QR38", title: "Stimulate Children's Minds" },
];
---

<BaseLayout title={`${t("gallery.title")} - ${siteConfig.name}`} lang={lang}>
  <Header lang={lang} currentPath="/gallery" />

  <section class="pt-32 pb-16 section-padding">
    <div class="container mx-auto">
      <ScrollReveal client:visible>
        <SectionHeading title={t("gallery.title")} subtitle={t("gallery.subtitle")} />
      </ScrollReveal>

      <div class="mt-12">
        <ScrollReveal client:visible>
          <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-8">{t("gallery.videos")}</h3>
        </ScrollReveal>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {videos.map((video, i) => (
            <ScrollReveal client:visible delay={i * 0.1}>
              <VideoPlayer client:visible videoId={video.id} title={video.title} />
            </ScrollReveal>
          ))}
        </div>
      </div>

      <div class="mt-20">
        <ScrollReveal client:visible>
          <h3 class="text-2xl font-serif font-bold text-[var(--color-text)] mb-8">{t("gallery.results")}</h3>
        </ScrollReveal>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {Array.from({ length: 6 }).map((_, i) => (
            <ScrollReveal client:visible delay={i * 0.1}>
              <div class="aspect-square bg-[var(--color-surface-elevated)] border border-[var(--color-border)] flex items-center justify-center">
                <p class="text-[var(--color-text-secondary)] text-sm">Treatment Result {i + 1}</p>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
