---
import { languages, type Lang } from "../i18n/languages";

interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = "/" } = Astro.props;
const otherLangs = Object.entries(languages).filter(([code]) => code !== lang);
---

<div class="relative group">
  <button
    class="flex items-center gap-1 text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200 uppercase cursor-pointer"
    aria-label="Switch language"
  >
    {lang}
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>
  <div class="absolute top-full right-0 mt-2 py-2 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-sm shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[120px]">
    {otherLangs.map(([code, data]) => (
      <a
        href={`/${code}${currentPath}`}
        class="block px-4 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-elevated)] transition-colors duration-150 cursor-pointer"
      >
        {data.label}
      </a>
    ))}
  </div>
</div>
