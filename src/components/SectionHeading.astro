---
interface Props {
  title: string;
  subtitle?: string;
  label?: string;
  align?: "left" | "center";
}

const { title, subtitle, label, align = "center" } = Astro.props;
---

<div class:list={["mb-14 lg:mb-20", align === "center" ? "text-center" : "text-start"]}>
  {label && (
    <p class="section-label mb-4">
      {label}
    </p>
  )}
  <h2 class="font-serif font-bold text-[var(--color-text)]">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-5 text-lg lg:text-xl text-[var(--color-text-secondary)] max-w-2xl leading-relaxed" class:list={[align === "center" && "mx-auto"]}>
      {subtitle}
    </p>
  )}
</div>
